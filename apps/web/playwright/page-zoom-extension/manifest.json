{
    "manifest_version": 3,
    "name": "Element Playwright page zoom",
    "version": "1.0",
    "description": "Provides real browser page zoom for the Playwright zoom project.",
    "permissions": ["tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}
