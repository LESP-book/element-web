.mx_FilePanel {
    order: 2;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;

    .mx_FilePanel_controls {
        padding: var(--cpd-space-3x);
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-2x);
    }

    .mx_FilePanel_filters {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--cpd-space-2x);

        > label {
            min-width: 0;
            font: var(--cpd-font-body-sm-regular);
        }

        input,
        select {
            box-sizing: border-box;
            display: block;
            width: 100%;
            min-width: 0;
        }
    }

    .mx_FilePanel_scrollPanel {
        flex: 1;
        min-height: 0;

        .mx_RoomView_messageListWrapper {
            justify-content: flex-start;
        }

        .mx_RoomView_MessageList {
            width: 100%;
            gap: var(--cpd-space-6x);
            justify-content: flex-start;
        }
    }

    .mx_FilePanel_mediaViewport {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .mx_FilePanel_mediaFooter {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .mx_RoomFileSearchTile {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        padding: var(--cpd-space-2x) var(--cpd-space-3x);
        min-width: 0;
    }

    .mx_RoomFileSearchTile_content {
        flex: 1;
        min-width: 0;
    }

    .mx_RoomFileSearchTile_name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_RoomFileSearchTile_meta {
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-regular);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_RoomMediaSearchTile {
        min-width: 0;
        padding: var(--cpd-space-2x);
        border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
        border-radius: 4px;
        background: var(--cpd-color-bg-subtle-secondary);
    }

    .mx_RoomMediaSearchTile_preview {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .mx_RoomMediaSearchTile_preview img,
    .mx_RoomMediaSearchTile_preview video {
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .mx_RoomMediaSearchTile_actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        min-width: 0;
        gap: var(--cpd-space-2x);
        margin-bottom: var(--cpd-space-2x);
    }

    .mx_RoomMediaSearchTile_name {
        min-width: 0;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_FilePanel_groupHeader {
        padding: var(--cpd-space-2x) var(--cpd-space-3x);
    }

    .mx_FilePanel_groupHeaderLabel {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_FilePanel_loading,
    .mx_FilePanel_noMore {
        padding: var(--cpd-space-3x);
        display: flex;
        justify-content: center;
    }

    .mx_FilePanel_empty {
        padding: var(--cpd-space-3x);
    }
}
